{
  "name": "fold",
  "private": true,
  "version": "0.1.0",
  "description": "Quorum: the multiplayer kernel for long-running agent sessions",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b packages/cli/tsconfig.json && pnpm --filter @fold/web run build",
    "typecheck": "tsc -b packages/cli/tsconfig.json && pnpm --filter @fold/web run typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "e2e": "bash scripts/e2e.sh",
    "demo": "pnpm --filter @fold/cli run demo",
    "serve": "pnpm --filter @fold/cli run serve",
    "web:smoke": "pnpm --filter @fold/web run smoke",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "^1.63.0",
    "@fold/kernel": "workspace:*",
    "@types/node": "^22.17.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  }
}
