{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Henosis",
  "version": "0.1.0",
  "identifier": "team.henosis.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @henosis/web dev",
    "beforeBuildCommand": "pnpm --filter @henosis/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Henosis",
        "create": false,
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["fold"]
      }
    },
    "updater": {
      "pubkey": "REPLACE_WITH_HENOSIS_DESKTOP_MINISIGN_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/raghavked/tech/releases/latest/download/latest.json",
        "https://releases.henosis.team/desktop/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Henosis",
    "longDescription": "The shared, living session for a team's long-running agents.",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      }
    }
  }
}
