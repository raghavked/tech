{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fold",
  "version": "0.1.0",
  "identifier": "studio.fold.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @fold/web dev",
    "beforeBuildCommand": "pnpm --filter @fold/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fold",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Fold"
    },
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["fold"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
