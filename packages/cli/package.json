{
  "name": "@tiller/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "demo": "tsx src/main.ts demo",
    "serve": "tsx src/main.ts serve"
  },
  "dependencies": {
    "@tiller/protocol": "workspace:*",
    "@tiller/kernel": "workspace:*",
    "@tiller/runner": "workspace:*",
    "@tiller/server": "workspace:*",
    "ws": "^8.18.3",
    "@tiller/fleet": "workspace:*",
    "@tiller/memory": "workspace:*",
    "@tiller/slack": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  },
  "bin": {
    "tiller": "./dist/main.js"
  }
}
